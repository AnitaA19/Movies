@page
@model Movie.Web.Pages.Movies.DetailsModel

<div class="movies-page py-4">
    <nav class="movie-breadcrumb mb-3">
        <a asp-page="/Movies/Index">Movies</a>
        <span class="movie-breadcrumb-sep">/</span>
        <span>@Model.Movie.Title</span>
    </nav>

    <div class="movie-details-shell">
        <div class="movie-details-hero">
            <div class="movie-details-hero-text">
                <p class="movies-eyebrow mb-2">Movie Details</p>
                <h1 class="movie-details-title mb-3">@Model.Movie.Title</h1>
                <div class="d-flex flex-wrap gap-2">
                    <span class="movie-chip">@Model.Movie.ReleaseYear</span>
                    <span class="movie-chip movie-chip-outline">@Model.Movie.StudioName</span>
                </div>
            </div>
            <div class="movie-details-id">
                <span class="movie-details-id-label">ID</span>
                <span class="movie-details-id-value">@Model.Movie.Id</span>
            </div>
        </div>

        <div class="movie-details-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="detail-tile">
                        <span class="detail-tile-label">Title</span>
                        <span class="detail-tile-value">@Model.Movie.Title</span>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="detail-tile">
                        <span class="detail-tile-label">Release Year</span>
                        <span class="detail-tile-value">@Model.Movie.ReleaseYear</span>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="detail-tile">
                        <span class="detail-tile-label">Studio</span>
                        <span class="detail-tile-value">@Model.Movie.StudioName</span>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="detail-tile">
                        <span class="detail-tile-label">Movie ID</span>
                        <span class="detail-tile-value">@Model.Movie.Id</span>
                    </div>
                </div>
            </div>

            <div class="movie-details-actions">
                <a class="btn movie-btn-primary movie-back-btn" asp-page="/Movies/Index">&larr; Back to Movies</a>
            </div>
        </div>
    </div>
</div>