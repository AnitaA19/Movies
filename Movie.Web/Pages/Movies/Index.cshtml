@page
@model Movie.Web.Pages.Movies.IndexModel

<div class="movies-page py-4">
    <div class="movies-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Movie Library</h1>
            <p class="text-muted mb-0">Browse all movies and open details.</p>
        </div>
        <span class="badge rounded-pill text-bg-dark px-3 py-2">@Model.Movies.Count Movies</span>
    </div>

    <div class="row g-3">
        @foreach (var movie in Model.Movies)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card movie-card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <a class="movie-title-link h5 mb-2" asp-page="/Movies/Details" asp-route-id="@movie.Id">
                            @movie.Title
                        </a>
                        <div class="movie-meta text-muted small mb-3">
                            <span class="me-2">@movie.ReleaseYear</span>
                            <span>•</span>
                            <span class="ms-2">@movie.StudioName</span>
                        </div>
                        <div class="mt-auto">
                            <a class="btn btn-primary w-100" asp-page="/Movies/Details" asp-route-id="@movie.Id">View Details</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</div>
